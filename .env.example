# ANENGOS 模型配置（复制为 .env 后填写）
# 豆包:   https://ark.cn-beijing.volces.com/api/v3
# DeepSeek: https://api.deepseek.com/v1
# OpenAI: https://api.openai.com/v1（默认）
ANENGOS_API_KEY=
ANENGOS_BASE_URL=https://api.openai.com/v1
ANENGOS_MODEL=gpt-4o-mini
# 访问令牌：必填！未配置时 /run 拒绝对外服务
# 调用时请求头带 Authorization: Bearer <token> 或 X-API-Token: <token>
ANENGOS_API_TOKEN=change-me-to-a-long-random-string
# docker-compose 对外端口
ANENGOS_PORT=8080
